# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model used for PS1/PS2/PS4 PDF review (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PROWORKFLOW_API_BASE_URL: Base URL for your ProWorkflow REST API (v4 or v1).
PROWORKFLOW_API_BASE_URL="https://api.proworkflow.com/api/v4"

# PROWORKFLOW_API_KEY: ProWorkflow account API key or Bearer token.
PROWORKFLOW_API_KEY=

# PROWORKFLOW_AUTH_HEADER: Header name for ProWorkflow auth ("apikey" for v4 or "Authorization" for Bearer).
PROWORKFLOW_AUTH_HEADER="apikey"

# PROWORKFLOW_WEBHOOK_SECRET: Optional shared secret verified on incoming POST /api/webhooks/proworkflow requests.
PROWORKFLOW_WEBHOOK_SECRET=

# ProWorkflow customizable route templates (use {taskId} and {projectId} placeholders)
PROWORKFLOW_TASK_PATH="/projects/items/{taskId}"
PROWORKFLOW_TASK_MESSAGES_PATH="/projects/items/{taskId}/messages"
PROWORKFLOW_POST_TASK_MESSAGE_PATH="/projects/items/{taskId}/messages"
PROWORKFLOW_PROJECT_PATH="/projects/{projectId}"
PROWORKFLOW_PROJECT_NOTES_PATH="/projects/{projectId}/notes"

# DRIVE_TO_GEMINI_UPLOAD_URL: Apps Script endpoint that uploads a Google Drive fileId to Gemini Files API.
DRIVE_TO_GEMINI_UPLOAD_URL="https://script.google.com/macros/s/AKfycbyfy_w8Cqlxsk2cAkIEK39cRWW-tW-_2vywukMcFNXBPrkCgqL_uDFtRsEZZl8pu3tXKQ/exec"

# DRIVE_TO_GEMINI_WEBHOOK_SECRET: Shared secret sent in JSON body to DRIVE_TO_GEMINI_UPLOAD_URL.
DRIVE_TO_GEMINI_WEBHOOK_SECRET=

# Pipeline behavior overrides
PROWORKFLOW_REVIEW_TAG="review-agent"
PROWORKFLOW_MENTION_TRIGGER="@review-agent"
MAX_CONCURRENT_REVIEWS="4"

